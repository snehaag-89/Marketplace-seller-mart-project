# Python bytecode & cache
__pycache__/
*.py[cod]
*$py.class
*.pyo
*.pyd

# Testing & coverage
.pytest_cache/
.coverage
htmlcov/
.cache/

# Virtual environments
.venv/
venv/
env/
ENV/

# Environment files & local secrets
.env
.env.*
!.env.example
*.pem
*.key

# Database files
*.db
*.sqlite
*.sqlite3
data/*.db
data/*.sqlite
data/*.sqlite3

# Raw data and generated outputs
data/raw/*.csv
outputs/*
!outputs/.gitkeep
!data/raw/.gitkeep

# Logs and temporary files
*.log
*.tmp
*.temp

# OS generated files
.DS_Store
Thumbs.db
